# Copy to .env (git-ignored); docker compose reads it automatically.

# Required — every service signs/verifies JWTs with this.
SECRET_KEY=change-me

# Required — project-service internal API (URL-safe characters only).
INTERNAL_API_PASSWORD=change-me

# Gateway host ports. Override when the default is already taken on your
# machine (e.g. a local node server on 8080 -> use 18080).
#GATEWAY_HTTPS_PORT=8443
#GATEWAY_HTTP_PORT=18080

# Gherkin import limits (test-management-service). Raise them together: the gateway's body cap
# must stay above IMPORT_MAX_TOTAL_BYTES plus JSON escaping (about 2.5x is safe).
#IMPORT_MAX_FILES=2000
#IMPORT_MAX_FILE_BYTES=262144
#IMPORT_MAX_TOTAL_BYTES=10485760
#GATEWAY_IMPORT_MAX_BODY=25m

# Running tests from QEOS (test-management-service): the Fernet key that encrypts each project's
# GitHub token. Empty turns the feature off (Settings says so). Generate one with:
#   openssl rand -base64 32 | tr '+/' '-_'
# or, with the cryptography package installed:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes stored tokens unreadable: owners then save the token again in Settings.
#TM_SECRETS_KEY=

# Postgres superuser password (local stack only).
#POSTGRES_PASSWORD=postgres


# SSO (optional) — pair with the auth-service allowlist configuration.
#VITE_GOOGLE_CLIENT_ID=
#VITE_MSAL_CLIENT_ID=
#VITE_MSAL_AUTHORITY=

# Monitoring (optional): Prometheus, Alertmanager, Grafana and exporters. COMPOSE_PROFILES turns it on and
# the two passwords are then required. 8 GB RAM recommended. MONITORING_ENABLED is for the QEOS sign-in to
# Grafana (/grafana/ at the gateway), which is not built yet; nothing reads it today.
#COMPOSE_PROFILES=monitoring
#MONITORING_ENABLED=true
#GRAFANA_ADMIN_PASSWORD=change-me
#MONITORING_DB_PASSWORD=change-me
# Alert channels: each turns on when set. Email also needs SMTP_HOST (and reuses the other SMTP_* values).
#ALERT_EMAIL_TO=ops@example.com
#ALERT_SLACK_WEBHOOK_URL=
#ALERT_TEAMS_WEBHOOK_URL=
#PROMETHEUS_RETENTION=15d
#PROMETHEUS_RETENTION_SIZE=5GB
#POSTGRES_DB_SIZE_ALERT_GB=20
# Only if the host already uses 172.30.1.0/24 (the gateway always joins this network, even with
# monitoring off). The range is the upper half of the subnet; the gateway address lies in the lower half.
#GRAFANA_FRONT_SUBNET=172.30.1.0/24
#GRAFANA_FRONT_IP_RANGE=172.30.1.128/25   # the bridge gateway 172.30.1.128 is only this with the default subnet
#GATEWAY_GRAFANA_FRONT_IP=172.30.1.10
