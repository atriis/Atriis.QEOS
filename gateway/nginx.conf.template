# QEOS gateway. Rendered by entrypoint.sh; only the variables it names are substituted.
# Routing, limits and TLS are specified in docs/superpowers/specs/2026-09-28-api-gateway-design.md.

#% Lines starting with #% are notes on this template: entrypoint.sh drops them, so the rendered file has none.
#% The ${...} settings and their defaults are in entrypoint.sh and gateway/README.md; the defaults render
#% compose's configuration exactly as it was before Kubernetes (scripts/tests/test_gateway_template.py).
worker_processes auto;
error_log /dev/stderr warn;
# Non-root with a read-only root filesystem (ADR-038): the pid and every temporary file live in /tmp
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    server_tokens off;
    default_type application/json;
    client_max_body_size 10m;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;

    # The client's X-Request-ID if it sent one, else NGINX's own
    map $http_x_request_id $req_id {
        default $http_x_request_id;
        ""      $request_id;
    }

    # The sign-in redirect's `next` for /grafana/ (grafana-on.conf): the path of the RAW request line, so
    # it stays percent-encoded. $uri is decoded: an encoded CR LF in it would split the Location header
    # and let a link set any response header. RFC 3986 path characters only, without `&` (which would
    # start a second query parameter) or raw non-ASCII bytes; anything else falls back to /grafana/
    map $request_uri $grafana_next {
        "~^(?<grafana_path>/grafana/[A-Za-z0-9._~!$'()*+,;=:@%/-]*)(\?|$)" $grafana_path;
        default "/grafana/";
    }

    # The Cookie header sent on to Grafana (grafana-on.conf): the browser's cookies without qeos_grafana,
    # which is the gateway's credential and none of Grafana's business; Grafana's own (grafana_session...)
    # pass unchanged. One pass removes one occurrence, wherever it sits (alone, first, middle, last) and
    # never leaves a stray "; "; two passes cover a browser that sends the cookie twice (two paths). No
    # Cookie header gives "", and proxy_set_header sends nothing. The check keeps $http_cookie. Whatever
    # the passes miss (a third copy, a space before "=") is refused with 400 in grafana-on.conf
    map $http_cookie $grafana_cookie_pass1 {
        "~^qeos_grafana=[^;]*(;\s*)?(?<gc1_rest>.*)$"                     $gc1_rest;
        "~^(?<gc1_head>.*?);\s*qeos_grafana=[^;]*(?<gc1_tail>(;.*)?)$"   "$gc1_head$gc1_tail";
        default $http_cookie;
    }
    map $grafana_cookie_pass1 $grafana_cookie {
        "~^qeos_grafana=[^;]*(;\s*)?(?<gc2_rest>.*)$"                     $gc2_rest;
        "~^(?<gc2_head>.*?);\s*qeos_grafana=[^;]*(?<gc2_tail>(;.*)?)$"   "$gc2_head$gc2_tail";
        default $grafana_cookie_pass1;
    }

    # The path as logged: a one-time link of the trace viewer (ADR-037) carries its token in the path, never logged,
    # and the viewer's own URL carries the whole link in its query (?trace=), so the viewer is logged without it.
    # Keyed on $uri (decoded, slashes merged): the form the location matches, so an encoded path is masked too
    map $uri $log_uri {
        "~*^/api/v1/artifact-links(/|$)" "/api/v1/artifact-links/***";
        "~*^/trace-viewer(/|$)" $uri;
        default $request_uri;
    }

    log_format json escape=json '{'
        '"time":"$time_iso8601",'
        '"request_id":"$req_id",'
        '"remote_addr":"$remote_addr",'
        '"method":"$request_method",'
        '"uri":"$log_uri",'
        '"status":$status,'
        '"upstream":"$upstream_addr",'
        '"upstream_response_time":"$upstream_response_time",'
        '"request_time":$request_time,'
        '"bytes_sent":$bytes_sent'
    '}';
    access_log /dev/stdout json;

    # Empty unless GATEWAY_TRUSTED_PROXIES is set (see entrypoint.sh)
    include ${NGINX_RENDER_DIR}/real_ip.conf;

    # Keyed on the client address: the TCP peer, or the real client behind a trusted
    # edge proxy - never a header a client could set
    limit_req_zone $binary_remote_addr zone=api:10m rate=${RATE_API};
    limit_req_zone $binary_remote_addr zone=auth:10m rate=${RATE_AUTH};
    limit_req_zone $binary_remote_addr zone=collect:10m rate=${RATE_COLLECT};
    limit_req_zone $binary_remote_addr zone=collect_blobs:10m rate=${RATE_COLLECT_BLOBS};
    limit_req_zone $binary_remote_addr zone=collect_artifacts:10m rate=${RATE_COLLECT_ARTIFACTS};
    limit_req_status 429;

    #% GATEWAY_RESOLVER: the cluster DNS on Kubernetes (ADR-038)
    # Docker's embedded DNS; with `proxy_pass $upstream` a recreated container (new IP) is found
    # within 10 s instead of the gateway returning 502 until it is restarted
    resolver ${GATEWAY_RESOLVER} valid=10s ipv6=off;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    # Overwritten, not appended: the gateway is the edge, so a client-supplied value is discarded
    proxy_set_header X-Forwarded-For $remote_addr;
    #% FORWARDED_PROTO: $scheme, or https when TLS ends at the edge (GATEWAY_TLS=off), whose only public scheme it is
    proxy_set_header X-Forwarded-Proto ${FORWARDED_PROTO};
    proxy_set_header X-Request-ID $req_id;
    proxy_connect_timeout 3s;
    proxy_read_timeout 30s;
    # The services' own error responses (JSON) pass through untouched
    proxy_intercept_errors off;
    # The services build redirect URLs (e.g. FastAPI's trailing-slash 307) from what they see:
    # plain http and a Host without the published port. Rewrite them back to the gateway's
    # public address, or clients are sent to http://localhost/ where nothing listens.
    proxy_redirect http://$host/ https://$host:${GATEWAY_PUBLIC_PORT}/;

    #% TLS_ONLY starts each line that exists only with GATEWAY_TLS=on: empty, or # to comment it out. With TLS off
    #% the server below listens on 8080 over HTTP (MAIN_LISTEN) and this redirect server is gone
${TLS_ONLY}    server {
${TLS_ONLY}        # Unprivileged ports inside the container (ADR-038); compose publishes them on the host ports
${TLS_ONLY}        listen 8080;
${TLS_ONLY}        server_name _;
${TLS_ONLY}
${TLS_ONLY}        location / {
${TLS_ONLY}            return 301 https://$host:${GATEWAY_PUBLIC_PORT}$request_uri;
${TLS_ONLY}        }
${TLS_ONLY}    }

    server {
        listen ${MAIN_LISTEN};
        server_name _;

${TLS_ONLY}        ssl_certificate     ${NGINX_CERT_DIR}/tls.crt;
${TLS_ONLY}        ssl_certificate_key ${NGINX_CERT_DIR}/tls.key;
${TLS_ONLY}        ssl_protocols       TLSv1.2 TLSv1.3;
        # No HSTS: on localhost with a self-signed certificate it would force HTTPS for every
        # localhost port in the browser.

        add_header X-Request-ID $req_id always;

        # NGINX's own errors as JSON. Each named location repeats X-Request-ID because an
        # add_header inside a location replaces the server-level ones.
        error_page 404 @not_found;
        error_page 413 @too_large;
        error_page 429 @too_many_requests;
        error_page 502 @bad_gateway;
        error_page 504 @gateway_timeout;

        location @not_found {
            add_header X-Request-ID $req_id always;
            return 404 '{"detail":"Not Found"}';
        }
        location @too_large {
            add_header X-Request-ID $req_id always;
            return 413 '{"detail":"Request Entity Too Large"}';
        }
        location @too_many_requests {
            add_header X-Request-ID $req_id always;
            add_header Retry-After 1 always;
            return 429 '{"detail":"Too Many Requests"}';
        }
        location @bad_gateway {
            add_header X-Request-ID $req_id always;
            return 502 '{"detail":"Bad Gateway"}';
        }
        location @gateway_timeout {
            add_header X-Request-ID $req_id always;
            return 504 '{"detail":"Gateway Timeout"}';
        }

        # ---- health (never rate-limited) ----
        location = /health {
            return 200 '{"status":"healthy"}';
        }
        location = /health/auth {
            set $upstream http://auth-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream/health;
        }
        location = /health/organizations {
            set $upstream http://organization-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream/health;
        }
        location = /health/projects {
            set $upstream http://project-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream/health;
        }
        location = /health/ingestion {
            set $upstream http://ingestion-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream/health;
        }
        location = /health/test-management {
            set $upstream http://test-management-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream/health;
        }

        # ---- test-management-service (ADR-022) ----
        # Gherkin import (ADR-023): a whole features/ folder in one request. Its own body cap,
        # GATEWAY_IMPORT_MAX_BODY, must stay above test-management's IMPORT_MAX_TOTAL_BYTES plus
        # JSON escaping; every other route keeps the 10m above
        location ~ ^/api/v1/projects/[0-9]+/cases/import$ {
            client_max_body_size ${GATEWAY_IMPORT_MAX_BODY};
            limit_req zone=api burst=40 nodelay;
            set $upstream http://test-management-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }

        # Report joins (ADR-026): every active case in one response; gzip only here and on
        # analytics/report, never server-wide (compressing responses that carry secrets or echo input
        # opens BREACH)
        location ~ ^/api/v1/projects/[0-9]+/case-areas$ {
            limit_req zone=api burst=40 nodelay;
            gzip on;
            gzip_proxied any;
            gzip_types application/json;
            gzip_min_length 1024;
            set $upstream http://test-management-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }


        # Regex, so it wins over project-service's /api/v1/projects prefix below
        location ~ ^/api/v1/projects/[0-9]+/(cases|case-labels|case-folders|case-features|case-areas|features|suites|ci-target|run-requests)(/|$) {
            limit_req zone=api burst=40 nodelay;
            set $upstream http://test-management-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }

        # ---- ingestion-service ----
        # The report (spec 2026-10-08): a POST with up to 20,000 test keys (about 1.4 MB) and up to 5,000
        # Play URLs (about 0.35 MB at 70 characters each, so a typical body is about 1.75 MB, under the 10m body
        # cap). URLs at the full 2,048 characters would exceed the cap and get a 413. The response is gzipped here only
        location ~ ^/api/v1/projects/[0-9]+/analytics/report$ {
            limit_req zone=api burst=40 nodelay;
            gzip on;
            gzip_proxied any;
            gzip_types application/json;
            gzip_min_length 1024;
            set $upstream http://ingestion-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }

        # Trace downloads and link requests (ADR-037): up to 100 MB streamed straight through, never written to the
        # gateway's temporary files, with the 120 s read timeout of trace uploads. Before the next regex location
        location ~ ^/api/v1/projects/[0-9]+/artifacts(/|$) {
            limit_req zone=api burst=40 nodelay;
            proxy_buffering off;
            proxy_read_timeout 120s;
            set $upstream http://ingestion-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }
        # A regex location wins over prefix locations, so this takes /api/v1/projects/{id}/api-keys,
        # /runs, /analytics, /masking-patterns, /log-patterns, /export and /notification-channels and /collection-settings and /screenshots away from project-service's /api/v1/projects prefix below.
        location ~ ^/api/v1/projects/[0-9]+/(api-keys|runs|analytics|masking-patterns|log-patterns|export|notification-channels|collection-settings|screenshots)(/|$) {
            limit_req zone=api burst=40 nodelay;
            set $upstream http://ingestion-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }
        # One-time links of the trace viewer (ADR-037): no Bearer token, the link itself is the credential, checked
        # by ingestion (60 s, the address that asked). Streamed like a download (unbuffered, 120 s read timeout).
        # The error log would print the request line, token included: here it keeps only critical messages, and
        # rate-limit refusals (429) are logged at info, below that
        location /api/v1/artifact-links {
            limit_req zone=api burst=40 nodelay;
            limit_req_log_level info;
            error_log /dev/stderr crit;
            proxy_buffering off;
            proxy_read_timeout 120s;
            set $upstream http://ingestion-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }
        location /api/v1/runs {
            limit_req zone=api burst=40 nodelay;
            set $upstream http://ingestion-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }
        # Step screenshots (ADR-036): a run can bring hundreds of images, each its own HEAD and PUT, so they get their
        # own zone and a body limit just over the 5 MB the service allows. Before /collect, the shorter prefix
        location /api/v1/collect/blobs {
            client_max_body_size 6m;
            limit_req zone=collect_blobs burst=100 nodelay;
            set $upstream http://ingestion-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }
        # Traces (ADR-037): up to 100 MB each, streamed through to the service (no buffering here, so a large upload
        # never sits on the gateway's disk), with their own zone. Before /collect, the shorter prefix
        location /api/v1/collect/artifacts {
            client_max_body_size 101m;
            proxy_request_buffering off;
            # After the last byte, ingestion still completes the upload and copies up to 100 MB in the store
            proxy_read_timeout 120s;
            proxy_send_timeout 120s;
            client_body_timeout 60s;
            limit_req zone=collect_artifacts burst=20 nodelay;
            set $upstream http://ingestion-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }
        # CI uploads get their own, lower limit, which also bounds a leaked key
        location /api/v1/collect {
            limit_req zone=collect burst=20 nodelay;
            set $upstream http://ingestion-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }
        # /metrics is deliberately not routed: it falls through to `location /`, which
        # serves the dashboard SPA's HTML — never a proxied service, so nothing leaks.

        # ---- project-service ----
        # A regex location wins over prefix locations, so this takes
        # /api/v1/organizations/{id}/projects[...] away from organization-service below.
        location ~ ^/api/v1/organizations/[0-9]+/projects(/|$) {
            limit_req zone=api burst=40 nodelay;
            set $upstream http://project-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }
        location /api/v1/projects {
            limit_req zone=api burst=40 nodelay;
            set $upstream http://project-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }

        # ---- organization-service ----
        location /api/v1/organizations {
            limit_req zone=api burst=40 nodelay;
            set $upstream http://organization-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }
        location /api/v1/invitations {
            limit_req zone=api burst=40 nodelay;
            set $upstream http://organization-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }

        # ---- auth-service ----
        # Endpoints that take a password or send an email get the stricter zone as well
        location = /api/v1/auth/login {
            limit_req zone=api burst=40 nodelay;
            limit_req zone=auth burst=10 nodelay;
            set $upstream http://auth-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }
        location = /api/v1/auth/register {
            limit_req zone=api burst=40 nodelay;
            limit_req zone=auth burst=10 nodelay;
            set $upstream http://auth-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }
        location = /api/v1/auth/forgot-password {
            limit_req zone=api burst=40 nodelay;
            limit_req zone=auth burst=10 nodelay;
            set $upstream http://auth-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }
        location = /api/v1/auth/reset-password {
            limit_req zone=api burst=40 nodelay;
            limit_req zone=auth burst=10 nodelay;
            set $upstream http://auth-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }
        location = /api/v1/auth/resend-verification {
            limit_req zone=api burst=40 nodelay;
            limit_req zone=auth burst=10 nodelay;
            set $upstream http://auth-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }
        location = /api/v1/auth/mfa/verify {
            limit_req zone=api burst=40 nodelay;
            # A sign-in attempt, like /auth/login: the stricter zone applies
            limit_req zone=auth burst=10 nodelay;
            set $upstream http://auth-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }
        location = /api/v1/auth/change-password {
            # Checks the current password, so it can be used to guess one: stricter zone
            limit_req zone=api burst=40 nodelay;
            limit_req zone=auth burst=10 nodelay;
            set $upstream http://auth-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }
        location /api/v1/auth {
            limit_req zone=api burst=40 nodelay;
            set $upstream http://auth-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }
        location /api/v1/users {
            limit_req zone=api burst=40 nodelay;
            set $upstream http://auth-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }
        location /api/v1/sso {
            limit_req zone=api burst=40 nodelay;
            # Sign-in endpoints all get the stricter zone, like /api/v1/auth/login
            limit_req zone=auth burst=10 nodelay;
            set $upstream http://auth-service${UPSTREAM_SUFFIX}:8000;
            proxy_pass $upstream;
        }

        # ---- Grafana (monitoring profile, ADR-027): grafana-on.conf or grafana-off.conf, chosen by
        # entrypoint.sh from MONITORING_ENABLED ----
        include ${NGINX_RENDER_DIR}/grafana.conf;

        # ---- unknown API paths ----
        # Longer prefixes and the regex locations above take every routed API path;
        # whatever is left under /api/ keeps the JSON 404 contract instead of
        # falling through to the SPA's HTML.
        location /api/ {
            add_header X-Request-ID $req_id always;
            return 404 '{"detail":"Not Found"}';
        }

        # ---- trace viewer (ADR-037), served by the dashboard ----
        # Its URL carries a one-time link in the query: the access log drops the query ($log_uri), and the error log,
        # which would print the request line, keeps only critical messages; rate-limit refusals (429) log at info
        location /trace-viewer/ {
            limit_req zone=api burst=40 nodelay;
            limit_req_log_level info;
            error_log /dev/stderr crit;
            set $upstream http://dashboard${UPSTREAM_SUFFIX}:8080;
            proxy_pass $upstream;
        }

        # ---- dashboard SPA (everything else) ----
        # The dashboard's own nginx falls unknown paths back to index.html.
        location / {
            limit_req zone=api burst=40 nodelay;
            set $upstream http://dashboard${UPSTREAM_SUFFIX}:8080;
            proxy_pass $upstream;
        }
    }
}
