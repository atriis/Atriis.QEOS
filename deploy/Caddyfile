{
	# Let's Encrypt account: certificate expiry notices go here
	email {$ACME_EMAIL}
}

{$QEOS_DOMAIN} {
	encode zstd gzip

	# Browsers keep to HTTPS for a year once they have seen the site over it
	header Strict-Transport-Security "max-age=31536000"

	# The gateway stays the application edge (routing, rate limits, JSON errors, request
	# ids); Caddy only terminates public TLS and renews the certificate. Inside the compose
	# network the gateway's certificate is self-signed, so this one hop skips verification.
	# 8443: the gateway's HTTPS port inside the container (it runs as non-root, ADR-038).
	reverse_proxy https://gateway:8443 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}
