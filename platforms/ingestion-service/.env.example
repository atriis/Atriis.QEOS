# Environment variables for the Ingestion Service
APP_NAME=Ingestion Service
DEBUG=False
API_V1_STR=/api/v1

# Must equal auth-service's SECRET_KEY: this service verifies the JWTs auth-service issues
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256

POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ingestion_db

PROJECT_SERVICE_URL=http://localhost:8002
PROJECT_SERVICE_TIMEOUT_SECONDS=3.0
MAX_RESULTS_PER_RUN=20000
MAX_TEXT_BYTES=65536

# Artifact storage for screenshots (ADR-036): all four, or screenshots stay off. docker-compose sets them for MinIO
#ARTIFACTS_S3_ENDPOINT=http://localhost:9000
#ARTIFACTS_S3_BUCKET=qeos-artifacts
#ARTIFACTS_S3_ACCESS_KEY=
#ARTIFACTS_S3_SECRET_KEY=
# Or Azure Blob through DefaultAzureCredential (workload identity on AKS, `az login` locally), no key (ADR-038)
#ARTIFACTS_BACKEND=azure
#ARTIFACTS_AZURE_ACCOUNT_URL=https://<account>.blob.core.windows.net
#ARTIFACTS_AZURE_CONTAINER=qeos-artifacts
