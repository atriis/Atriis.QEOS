# Shell scripts and the NGINX template are copied into Linux containers; a CRLF there turns
# "#!/bin/sh" into "/bin/sh\r: not found". Force LF regardless of a contributor's autocrlf.
*.sh                    text eol=lf
*.template              text eol=lf
# Compose's Prometheus files, Grafana's dashboards and the chart's byte-for-byte copies of them
# (tests/monitoring_files_test.sh compares the bytes): LF on every checkout, so an editor's CRLF never makes a copy
# differ from its original
monitoring/**/*.yml                         text eol=lf
monitoring/grafana/dashboards/*.json        text eol=lf
deploy/helm/qeos/files/monitoring/**        text eol=lf
